# Required. Postgres (Neon). On Vercel, add Neon from the Storage tab and
# this is set for you; locally, `vercel env pull .env.local`.
DATABASE_URL=

# Required for live research runs. Without it, you can still load the
# sample run and browse history, but new runs show a notice.
# Set this to your OpenRouter API key (free-tier keys work).
OPENAI_API_KEY=

# Optional. Defaults to https://openrouter.ai/api/v1
# OPENAI_BASE_URL=

# Optional. Any OpenRouter chat model id. Must be a free-tier id if your
# key can't pay. Defaults to nvidia/nemotron-3.5-super-vl:free.
# OPENAI_MODEL=

# Optional. Tried when the primary model's provider errors.
# Defaults to nvidia/nemotron-3.5-lightning:free.
# OPENAI_FALLBACK_MODEL=

# Search backends (first configured key wins, else keyless DuckDuckGo):
# - Tavily: free tier, no card. Recommended for demos.
# TAVILY_API_KEY=
# - Brave Search API: free tier but requires a card.
# BRAVE_API_KEY=
